{
  "name": "pinia-persistence-plugin",
  "description": "Pinia persistence plugin",
  "version": "0.0.7",
  "private": false,
  "author": "Noé Gnanih <noegnanih@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "typings": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "dev-server": "pnpm --parallel vite",
    "dev-types": "vue-tsc  --noEmit -p tsconfig.json --watch",
    "build": "yarn build-plugin && yarn build-types",
    "build-plugin": "vite build",
    "build-types": "vue-tsc --emitDeclarationOnly --declaration -p tsconfig.json",
    "lint": "eslint 'src/**/*.{ts,vue}'",
    "test": "vitest",
    "test-ci": "vitest --run",
    "version": "auto-changelog --template keepachangelog --hide-credit -p && git add CHANGELOG.md"
  },
  "peerDependencies": {
    "pinia": "^2.3.0 || ^3.0.0"
  },
  "devDependencies": {
    "auto-changelog": "^2.5.0",
    "vite": "^4.5.14",
    "vitest": "^0.28.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeGnh/pinia-persistence-plugin.git"
  },
  "keywords": [
    "vue",
    "pinia",
    "persistence",
    "pinia-plugin"
  ],
  "bugs": {
    "url": "https://github.com/noeGnh/pinia-persistence-plugin/issues"
  },
  "homepage": "https://github.com/noeGnh/pinia-persistence-plugin#readme",
  "publishConfig": {
    "access": "public"
  }
}
